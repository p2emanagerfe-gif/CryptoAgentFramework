# Copy to .env and fill in real values — never commit this file.
#
# X (Twitter) API v2 — needs a developer account with Elevated/paid write
# access and an app with OAuth 1.0a "Read and Write" permissions. Generate
# the access token + secret for the specific account you want posting
# (Developer Portal -> your app -> Keys and tokens -> Access Token and Secret).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Discord — a channel webhook URL (Channel Settings -> Integrations -> Webhooks
# -> New Webhook -> Copy URL). Simpler and lower-privilege than a full bot
# token since it can only post to that one channel, nothing else.
DISCORD_WEBHOOK_URL=

# xAI (Grok) Imagine API key — only needed for `node src/index.js generate-image`.
# Get one from https://console.x.ai (a paid xAI account with API access).
# Costs money per image (xAI's published starting price is $0.02/image as of
# 2026-08) — this is not covered by an X or Discord subscription.
XAI_API_KEY=